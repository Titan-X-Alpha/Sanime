# ==========================================
# SANIME - Environment Configuration
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Cloudflare R2 Storage (S3-Compatible)
# ------------------------------------------
# Your Cloudflare Account ID (Found in Cloudflare Dashboard -> R2)
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 API Token with Object Read & Write permissions
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Target Bucket Name (e.g., sanime-media)
R2_BUCKET_NAME=sanime-media

# Optional: Public R2 custom domain if configured (not strictly required for private presigned streaming)
# R2_PUBLIC_DOMAIN=https://media.yourdomain.com

# ------------------------------------------
# Supabase PostgreSQL Database (Optional in dev, required in production)
# When omitted, SANIME automatically falls back to an atomic local store (.data/sanime_store.json)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# Application Quota Settings (Bytes)
# Default: 10 GB = 10 * 1024 * 1024 * 1024 = 10737418240
# ------------------------------------------
MAX_STORAGE_QUOTA_BYTES=10737418240
